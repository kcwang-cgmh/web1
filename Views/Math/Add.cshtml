@model web1.Models.AddModel

<H1>Math Addition</H1>

<form method="post" action="/Math/Add">
  <span>No1:</span>
  <input type="text" name="No1" value="@Model?.No1" /><br />
  <span>No2:</span>
  <input type="text" name="No2" value="@Model?.No2" /><br />
  <input type="submit" value="Calculate" /><br />
  <span>Result:</span>@Model?.Answer
</form>