{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "clean-usings",
      "detail": "移除整個專案未使用的 using（IDE0005）",
      "type": "shell",
      "command": "dotnet",
      "args": [
        "format",
        "analyzers",
        "--diagnostics",
        "IDE0005",
        "--severity",
        "warn"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "silent",
        "panel": "shared",
        "clear": true,
        "showReuseMessage": false
      }
    }
  ]
}
